# Fotos de propiedades (Vercel Blob): conecta el store al proyecto desde el
# dashboard (Storage → tu store → Projects → Connect to Project) y trae las
# variables con: npx vercel link && npx vercel env pull .env.vercel
# (luego copia las líneas BLOB_*/VERCEL_OIDC_TOKEN a tu .env.local).
# El SDK se autentica con OIDC (BLOB_STORE_ID + VERCEL_OIDC_TOKEN) y usa
# BLOB_READ_WRITE_TOKEN solo como fallback fuera de Vercel. Solo las usa el
# servidor (POST /api/uploads y borrado de blobs).
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_READ_WRITE_TOKEN=
